    {
      "parameters": {
        "jsCode": "// Checks the CRM's Standard Webhooks signature against the exact bytes received,\n// before anything else runs. Paste the signing secret from the CRM's Webhooks\n// connection below. On n8n plans with Variables, use $vars.CRM_SIGNING_SECRET\n// instead, so exported copies of this workflow leave the secret out.\nconst secret = 'PASTE_THE_SIGNING_SECRET';\nconst crypto = require('crypto');\nif (!secret.startsWith('whsec_')) {\n  throw new Error(\"Paste the signing secret from the CRM's Webhooks connection.\");\n}\n\nconst { headers } = $input.first().json;\nconst body = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst id = headers['webhook-id'] || '';\nconst timestamp = headers['webhook-timestamp'] || '';\nconst key = Buffer.from(secret.slice('whsec_'.length), 'base64');\nconst hmac = crypto.createHmac('sha256', key).update(`${id}.${timestamp}.`).update(body);\nconst expected = Buffer.from(`v1,${hmac.digest('base64')}`);\nconst signed = (headers['webhook-signature'] || '').split(' ').some((candidate) => {\n  const given = Buffer.from(candidate);\n  return given.length === expected.length && crypto.timingSafeEqual(given, expected);\n});\nconst fresh = Math.abs(Date.now() / 1000 - Number(timestamp)) < 300;\nif (!signed || !fresh) {\n  return [{ json: { valid: false } }];\n}\n\nconst event = JSON.parse(body.toString('utf8'));\nreturn [{ json: { valid: true, id, type: event.type, data: event.data } }];\n"
      },
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
