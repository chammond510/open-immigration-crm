# Local Docker evaluation settings. See docs/DEPLOYMENT.md before production use.
DEBUG=false
SECRET_KEY=replace-with-at-least-50-random-characters
POSTGRES_PASSWORD=replace-with-a-unique-database-password
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=America/Chicago
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
# Enable these only after every subdomain is permanently HTTPS; see deployment docs.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DOCUMENT_UPLOAD_MAX_BYTES=20971520
